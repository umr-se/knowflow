# Local FastAPI development. Process environment variables override these values.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/knowflow

# Local LLM through Ollama. Good default for an 8 GB machine.
OLLAMA_BASE_URL=http://localhost:11434
CHAT_MODEL=qwen2.5:1.5b
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=120
MAX_CONTEXT_CHARS=12000

# Local embeddings (CPU-friendly, 384 dimensions)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

CORS_ORIGINS=http://localhost:3000
CHUNK_SIZE=900
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=5
MIN_RETRIEVAL_SCORE=0.20
MAX_UPLOAD_MB=30

# Keep Hugging Face / sentence-transformers cache inside this project.
HF_HOME=./models/huggingface
TRANSFORMERS_CACHE=./models/huggingface
